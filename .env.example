# ---------------------------------------------------------------------------
# Environment template for bnb-agent-marketplace.
#
# Copy to `.env` and fill in real values. Every secret MUST be replaced with
# a real value before going to production; the `change-me` placeholders are
# here so a missed variable fails loudly at startup instead of silently
# accepting a default.
#
# Rule: never commit `.env`. `.env.example` is the only file that should be
# tracked, and it must never contain a real key (id 12 hygiene).
# ---------------------------------------------------------------------------

# ---- Postgres (used by docker-compose) -------------------------------------
# These three are read by `db` and substituted into the app's DATABASE_URL.
POSTGRES_USER=bnb
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bnb_agent

# ---- App runtime ----------------------------------------------------------
# asyncpg DSN. Inside docker-compose the hostname is the service name `db`.
# Locally with `uv run`, point it at localhost:5432 instead.
DATABASE_URL=postgresql+asyncpg://bnb:change-me@db:5432/bnb_agent

# ---- 8004scan upstream ----------------------------------------------------
# Public API base. Override only if you proxy through a mirror.
8004SCAN_BASE=https://8004scan.io/api/v1/public

# Optional Pro tier key. Leaving this empty drops the worker to free-tier
# limits (~50 rpm) and the worker logs a [WARN] on startup (spec sync-worker
# R8, decision Q7). Get a free hackathon key at
# https://8004scan.io/developers (form: https://forms.gle/jQevEPCAacBXaKG79).
8004SCAN_API_KEY=change-me

# ---- Session / security ---------------------------------------------------
# Used to sign the session cookie and derive the CSRF token. MUST be at
# least 32 random bytes. Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-32-bytes-min

# Session lifetime in minutes (default 60).
SESSION_TTL_MIN=60

# Optional shared secret protecting the remote sync API (POST/GET /api/sync).
# Required only if you call sync over HTTP; leave empty to disable the API
# (the endpoints answer 503). Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SYNC_API_KEY=

# ---- Observability / worker -----------------------------------------------
# Standard log level for uvicorn + the app loggers.
LOG_LEVEL=INFO

# Soft cap on the rate the sync worker hits the upstream (spec
# sync-worker R4). The hard cap is enforced by an asyncio.Semaphore(4) in
# the client.
WORKER_RATE_PER_SEC=4

# ---- x402 payments (FU-2) -------------------------------------------------
# BSC chain payments settle on: 97 = testnet (default), 56 = mainnet (demo
# day override). The $U address and default RPC follow this value.
X402_CHAIN_ID=97

# Facilitator EOA private key (hex, with or without 0x). The facilitator
# only pays gas — envelope funds are recipient-bound, so a leaked key cannot
# redirect them. NEVER commit a real key; leave empty to disable payments
# (POST /api/hires/{id}/pay answers 503 payment_gateway_unconfigured).
X402_FACILITATOR_KEY=change-me

# Optional RPC override. Empty uses the per-chain public node:
#   97 → https://bsc-testnet-rpc.publicnode.com
#   56 → https://bsc-rpc.publicnode.com
X402_RPC_URL=

# Flat hire price in USD, shown on the Hire CTA ($1.00).
X402_DEFAULT_PRICE_USD=1.00

# Pinned $U (United Stables) addresses per chain — public constants from
# @altananetwork/x402-server (verified against live DOMAIN_SEPARATOR()).
X402_U_TOKEN_ADDRESS_56=0xcE24439F2D9C6a2289F741120FE202248B666666
X402_U_TOKEN_ADDRESS_97=0xc70B8741B8B07A6d61E54fd4B20f22Fa648E5565

# Permit2 address — reserved for future rails (unused in v1).
X402_PERMIT2_ADDRESS=0x000000000022D473030F116dDEE9F6B43aC78BA3
